<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS (disain.tallinn.ee). Without a Cache-Control header browsers cache
  static files heuristically, so after a deploy they can keep an old
  component script or stylesheet next to new page HTML. max-age=0 makes them
  revalidate with the existing ETag on every load (a cheap 304 when unchanged).
-->
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="0.00:00:00" />
    </staticContent>
  </system.webServer>
</configuration>
